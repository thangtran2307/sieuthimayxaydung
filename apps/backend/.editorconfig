# Code style for the .NET backend — enforced with `dotnet format`.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
# Language conventions
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# EF Core materializes entity setters via reflection, so "unused private setter/member" rules are
# false positives for our DDD entities. Keep them advisory (visible in SonarQube) but do not let
# `dotnet format` auto-remove the private setters we intentionally use for encapsulation.
[*.cs]
dotnet_diagnostic.S1144.severity = suggestion
dotnet_diagnostic.S3459.severity = suggestion

[*.cs]
# IDE0005: Remove unnecessary usings / imports
dotnet_diagnostic.IDE0005.severity = warning

[*.{csproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 4
